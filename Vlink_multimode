// ===== Mode Switching =====
void switchMode() {
  // Reset all states
  sendMouseReport(0, 0, 0, 0);
  releaseAllKeys();
  
  leftPressed = false;
  rightPressed = false;
  dragging = false;
  scrolling = false;
  nitroActive = false;
  driftActive = false;
  upPressed = false;
  downPressed = false;
  lastSteerValue = 0;
  
  // Cycle to next mode
  currentMode = (ControlMode)((currentMode + 1) % 4);
  
  modeJustSwitched = true;
  modeSwitchDisplayTime = millis();
  
  Serial.printf("→ MODE SWITCHED TO: %s\n", modeNames[currentMode]);
  displayModeSwitch();
  delay(1500);
}

void checkModeSwitchGesture(bool iBent, bool mBent, bool tBent, bool rBent, bool pBent) {
  bool allBent = iBent && mBent && tBent && rBent && pBent;
  
  if (allBent && !modeSwitchPending) {
    modeSwitchPending = true;
    allFingersStartTime = millis();
    Serial.println("→ Mode switch gesture detected...");
  } else if (!allBent && modeSwitchPending) {
    modeSwitchPending = false;
    Serial.println("→ Mode switch cancelled");
  }
  
  if (modeSwitchPending && (millis() - allFingersStartTime >= 5000)) {
    switchMode();
    modeSwitchPending = false;
  }
}

// ===== Mode Handlers =====
void handleMouseMode(float yawRate, float pitchRate, float rollRate, 
                     bool iBent, bool mBent, bool tBent, bool rBent, bool pBent) {
  
  int8_t moveX = 0;
  int8_t moveY = 0;
  uint8_t buttons = 0;
  int8_t wheel = 0;
  
  // Cursor movement
  if (fabs(yawRate) > MOTION_THRESHOLD) {
    moveX = constrain((int8_t)(yawRate * CURSOR_SENSITIVITY), -127, 127);
  }
  if (fabs(pitchRate) > MOTION_THRESHOLD) {
    moveY = constrain((int8_t)(-pitchRate * CURSOR_SENSITIVITY), -127, 127);
  }
  
  // Drag mode (Thumb only)
  if (tBent && !dragging) {
    leftPressed = false;
    rightPressed = false;
    scrolling = false;
    dragging = true;
    Serial.println("→ DRAG START");
  } else if (!tBent && dragging) {
    dragging = false;
    Serial.println("→ DRAG END");
  }

  // Scroll mode (Pinky)
  if (pBent && !scrolling && !dragging) {
    scrolling = true;
    Serial.println("→ SCROLL MODE ON");
  } else if (!pBent && scrolling) {
    scrolling = false;
    Serial.println("→ SCROLL MODE OFF");
  }
  
  // Scrolling
  if (scrolling) {
    if (fabs(pitchRate) > SCROLL_TILT_DEAD) {
      wheel = constrain((int8_t)(-pitchRate * SCROLL_SENSITIVITY), -5, 5);
    }
  }

  if (!dragging && !scrolling) {
    // Left click (Index only)
    if (iBent && !mBent) {
      if (!leftPressed) {
        leftPressed = true;
        Serial.println("→ LEFT CLICK");
      }
      buttons |= 0x01;
    } else {
      leftPressed = false;
    }

    // Right click (Middle only)
    if (mBent && !iBent) {
      if (!rightPressed) {
        rightPressed = true;
        Serial.println("→ RIGHT CLICK");
      }
      buttons |= 0x02;
    } else {
      rightPressed = false;
    }
  } else if (dragging) {
    buttons |= 0x01; // Hold left button during drag
  }

  sendMouseReport(buttons, moveX, moveY, wheel);

  display.clearDisplay();
  display.setTextSize(1);
  int battPct = getBatteryPercent();
  display.setCursor(82, 2);
  display.printf("%d%%", battPct);
  drawBatteryIcon(108, 2, battPct);
  
  display.setTextSize(2);
  display.setCursor(5, 15);
  display.print("Mouse Mode");
  
  display.setTextSize(1);
  String control = "";
  if (scrolling) control = "SCROLL";
  else if (dragging) control = "DRAG";
  else if (leftPressed) control = "LEFT CLICK";
  else if (rightPressed) control = "RIGHT CLICK";
  else control = "Ready";
  
  int16_t x1, y1;
  uint16_t w, h;
  display.getTextBounds(control.c_str(), 0, 0, &x1, &y1, &w, &h);
  display.setCursor((SCREEN_WIDTH - w) / 2, 38);
  display.print(control);
  display.display();
}

void handlePresentationMode(float yawRate, float pitchRate, 
                           bool iBent, bool mBent, bool tBent, bool rBent, bool pBent) {

  static bool nextPressed = false;
  if (iBent && !nextPressed && !mBent) {
    sendKeyPress(KEY_RIGHT_ARROW);
    nextPressed = true;
    Serial.println("→ NEXT SLIDE");
  } else if (!iBent && nextPressed) {
    nextPressed = false;
  }

  static bool prevPressed = false;
  if (mBent && !prevPressed && !iBent) {
    sendKeyPress(KEY_LEFT_ARROW);
    prevPressed = true;
    Serial.println("→ PREV SLIDE");
  } else if (!mBent && prevPressed) {
    prevPressed = false;
  }

  static bool presToggle = false;
  if (tBent && !presToggle) {
    if (!presenting) {
      sendKeyPress(KEY_F5);
      presenting = true;
      Serial.println("→ START PRESENTATION");
    } else {
      sendKeyPress(KEY_ESC);
      presenting = false;
      Serial.println("→ STOP PRESENTATION");
    }
    presToggle = true;
  } else if (!tBent && presToggle) {
    presToggle = false;
  }

  display.clearDisplay();
  display.setTextSize(1);
  int battPct = getBatteryPercent();
  display.setCursor(82, 2);
  display.printf("%d%%", battPct);
  drawBatteryIcon(108, 2, battPct);
  
  display.setTextSize(2);
  display.setCursor(5, 15);
  display.print("Present");
  
  display.setTextSize(1);
  String status = "";
  if (nextPressed) status = "Next Slide";
  else if (prevPressed) status = "Prev Slide";
  else if (presenting) status = "Presenting";
  else status = "Ready";
  
  int16_t x1, y1;
  uint16_t w, h;
  display.getTextBounds(status.c_str(), 0, 0, &x1, &y1, &w, &h);
  display.setCursor((SCREEN_WIDTH - w) / 2, 38);
  display.print(status);
  display.display();
}

