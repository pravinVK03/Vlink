  hid->setReportMap((uint8_t*)COMBINED_REPORT_MAP, sizeof(COMBINED_REPORT_MAP));

  inputMouse = hid->getInputReport(1);
  inputKeyboard = hid->getInputReport(2);

  hid->startServices();

  NimBLEAdvertising* pAdvertising = NimBLEDevice::getAdvertising();
  pAdvertising->setAppearance(0x03C2); // HID Keyboard appearance
  pAdvertising->addServiceUUID(hid->getHidService()->getUUID());
  pAdvertising->setScanResponse(false);
  pAdvertising->setMinInterval(0x06); // Help with connections
  pAdvertising->setMaxInterval(0x12);
  pAdvertising->start();
  
  Serial.println("OK");
  Serial.println("BLE Device Name: Vlink");
  Serial.println("BLE Advertising started!");
  
  smoothedBatteryVoltage = readBatteryVoltage();
  
  showStatus("Ready");
  delay(1000);
  
  lastUpdate = millis();
  
  Serial.println("=== System Ready ===");
  Serial.printf("Free Heap: %d bytes\n", ESP.getFreeHeap());
}

void loop() {
  if (!bleConnected) {
    showStatus("Waiting");
    delay(200);
    return;
  }

  static bool shownConnected = false;
  if (!shownConnected) {
    showStatus("Connected");
    delay(1000);
    shownConnected = true;
    Serial.println("✓ Device Connected");
  }

  sensors_event_t a, g, t;
  if (!mpu.getEvent(&a, &g, &t)) {
    Serial.println("ERROR: MPU read failed!");
    delay(100);
    return;
  }
  
  unsigned long now = millis();
  float dt = (now - lastUpdate) / 1000.0;
  lastUpdate = now;

  float yawRate = g.gyro.z - gyroYawOffset;
  float pitchRate = g.gyro.y - gyroPitchOffset;
  float rollRate = g.gyro.x - gyroRollOffset;
  
  if (fabs(yawRate) < GYRO_DEAD) yawRate = 0;
  if (fabs(pitchRate) < GYRO_DEAD) pitchRate = 0;
  if (fabs(rollRate) < GYRO_DEAD) rollRate = 0;

  int fI = analogRead(FLEX_INDEX);
  int fM = analogRead(FLEX_MIDDLE);
  int fT = analogRead(FLEX_THUMB);
  int fR = analogRead(FLEX_RING);
  int fP = analogRead(FLEX_PINKY);

  bool iBent = fI > FLEX_INDEX_THRESH;
  bool mBent = fM > FLEX_MIDDLE_THRESH;
  bool tBent = fT > FLEX_THUMB_THRESH;
  bool rBent = fR > FLEX_RING_THRESH;
  bool pBent = fP > FLEX_PINKY_THRESH;

  checkModeSwitchGesture(iBent, mBent, tBent, rBent, pBent);

  if (modeSwitchPending) {
    unsigned long elapsed = millis() - allFingersStartTime;
    int progress = map(elapsed, 0, 5000, 0, 100);
    
    display.clearDisplay();
    display.setTextSize(1);
    int battPct = getBatteryPercent();
    display.setCursor(82, 2);
    display.printf("%d%%", battPct);
    drawBatteryIcon(108, 2, battPct);
    
    display.setTextSize(2);
    display.setCursor(10, 15);
    display.print("Switching");
    
    display.setTextSize(1);
    display.setCursor(20, 40);
    display.printf("Hold: %d%%", progress);
    
    display.drawRect(10, 52, 108, 8, SSD1306_WHITE);
    int barWidth = map(progress, 0, 100, 0, 106);
    display.fillRect(11, 53, barWidth, 6, SSD1306_WHITE);
    
    display.display();
    delay(50);
    return;
  }

  switch (currentMode) {
    case MODE_MOUSE:
      handleMouseMode(yawRate, pitchRate, rollRate, iBent, mBent, tBent, rBent, pBent);
      break;
      
    case MODE_PRESENTATION:
      handlePresentationMode(yawRate, pitchRate, iBent, mBent, tBent, rBent, pBent);
      break;
      
    case MODE_MEDIA:
      handleMediaMode(yawRate, pitchRate, iBent, mBent, tBent, rBent, pBent);
      break;
      
    case MODE_GAME_ASPHALT:
      handleAsphalt8Mode(yawRate, pitchRate, rollRate, iBent, mBent, tBent, rBent, pBent);
      break;
  }

  delay(10);
}
