void handleAsphalt8Mode(float yawRate, float pitchRate, float rollRate,
                       bool iBent, bool mBent, bool tBent, bool rBent, bool pBent) {

  if (tBent && !nitroActive) {
    pressKey(KEY_UP_ARROW);
    nitroActive = true;
    Serial.println("→ NITRO ON");
  } else if (!tBent && nitroActive) {
    releaseKey(KEY_UP_ARROW);
    nitroActive = false;
    Serial.println("→ NITRO OFF");
  }
  
  bool wantDrift = iBent && mBent;
  if (wantDrift && !driftActive) {
    pressKey(KEY_SPACE);
    driftActive = true;
    Serial.println("→ DRIFT ON");
  } else if (!wantDrift && driftActive) {
    releaseKey(KEY_SPACE);
    driftActive = false;
    Serial.println("→ DRIFT OFF");
  }
  
  if (!nitroActive) {
    if (pitchRate < TILT_UP_THRESH && !upPressed) {
      pressKey(KEY_UP_ARROW);
      upPressed = true;
      Serial.println("→ UP ARROW");
    } else if (pitchRate >= TILT_UP_THRESH && upPressed) {
      releaseKey(KEY_UP_ARROW);
      upPressed = false;
    }
    
    if (pitchRate > TILT_DOWN_THRESH && !downPressed) {
      pressKey(KEY_DOWN_ARROW);
      downPressed = true;
      Serial.println("→ DOWN ARROW");
    } else if (pitchRate <= TILT_DOWN_THRESH && downPressed) {
      releaseKey(KEY_DOWN_ARROW);
      downPressed = false;
    }
  }
  
  // Roll: Steering (Left/Right arrows)
  int steerValue = 0;
  if (fabs(rollRate) > STEER_DEAD) {
    steerValue = constrain((int)(rollRate * STEER_SENSITIVITY), -3, 3);
  }
  
  if (steerValue < 0) {
    pressKey(KEY_LEFT_ARROW);
    if (lastSteerValue >= 0) releaseKey(KEY_RIGHT_ARROW);
  } else if (steerValue > 0) {
    pressKey(KEY_RIGHT_ARROW);
    if (lastSteerValue <= 0) releaseKey(KEY_LEFT_ARROW);
  } else {
    releaseKey(KEY_LEFT_ARROW);
    releaseKey(KEY_RIGHT_ARROW);
  }
  lastSteerValue = steerValue;

 
  display.clearDisplay();
  display.setTextSize(1);
  int battPct = getBatteryPercent();
  display.setCursor(82, 2);
  display.printf("%d%%", battPct);
  drawBatteryIcon(108, 2, battPct);
  
  display.setTextSize(2);
  display.setCursor(5, 15);
  display.print("Asphalt 8");
  
  display.setTextSize(1);
  String state = "";
  if (nitroActive) state = "NITRO!";
  else if (driftActive) state = "DRIFT";
  else if (upPressed) state = "Accelerate";
  else if (downPressed) state = "Brake";
  else if (steerValue < 0) state = "Steer Left";
  else if (steerValue > 0) state = "Steer Right";
  else state = "Ready";
  
  int16_t x1, y1;
  uint16_t w, h;
  display.getTextBounds(state.c_str(), 0, 0, &x1, &y1, &w, &h);
  display.setCursor((SCREEN_WIDTH - w) / 2, 38);
  display.print(state);
  display.display();
}


void setup() {
  Serial.begin(115200);
  delay(1000);
  
  Serial.println("\n=== Vlink Controller (NimBLE) ===");
  
  Wire.begin();
  Wire.setClock(400000);
  
  analogReadResolution(12);
  analogSetAttenuation(ADC_11db);
  
  // Initialize Display
  Serial.print("Initializing Display... ");
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("FAILED!");
    while (1) delay(1000);
  }
  Serial.println("OK");
  
  display.clearDisplay();
  display.setTextSize(3);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(25, 20);
  display.println("Vlink");
  display.display();
  delay(2000);

  Serial.print("Initializing MPU6050... ");
  if (!mpu.begin(0x68)) {
    Serial.println("FAILED at 0x68!");
    Serial.print("Trying 0x69... ");
    if (!mpu.begin(0x69)) {
      Serial.println("FAILED!");
      showStatus("MPU ERR");
      while (1) delay(1000);
    }
  }
  Serial.println("OK");
  
  mpu.setAccelerometerRange(MPU6050_RANGE_4_G);
  mpu.setGyroRange(MPU6050_RANGE_250_DEG);
  mpu.setFilterBandwidth(MPU6050_BAND_21_HZ);

  Serial.print("Calibrating Gyro... ");
  if (!calibrateGyro()) {
    Serial.println("FAILED!");
    showStatus("CAL ERR");
    while (1) delay(1000);
  }
  Serial.println("OK");
  
  Serial.print("Starting NimBLE... ");
  NimBLEDevice::init("Vlink");
  NimBLEDevice::setPower(ESP_PWR_LVL_P9); // Max power for better range
  
  NimBLEServer* pServer = NimBLEDevice::createServer();
  pServer->setCallbacks(new ServerCallbacks());

  hid = new NimBLEHIDDevice(pServer);

  hid->setManufacturer("VisionLabs");
  hid->setPnp(0x02, 0xe502, 0xa111, 0x0210); // BT, Vendor, Product, Version
  hid->setHidInfo(0x00, 0x01); // Country, Flags
  
  const uint8_t COMBINED_REPORT_MAP[] = {
