void sendMouseReport(uint8_t buttons, int8_t x, int8_t y, int8_t wheel) {
  if (!bleConnected || !inputMouse) return;
  
  uint8_t report[5]; 
  report[0] = 0x01;  
  report[1] = buttons;
  report[2] = x;
  report[3] = y;
  report[4] = wheel;
  
  inputMouse->setValue(report, 5);
  inputMouse->notify();
}

void sendKeyPress(uint8_t key) {
  if (!bleConnected || !inputKeyboard) return;
  
  uint8_t report[9]; // Report ID + 8 bytes
  report[0] = 0x02;  // Report ID for Keyboard
  memset(&report[1], 0, 8);
  report[3] = key;   // First key slot
  
  inputKeyboard->setValue(report, 9);
  inputKeyboard->notify();
  delay(10);
  
  memset(&report[1], 0, 8);
  inputKeyboard->setValue(report, 9);
  inputKeyboard->notify();
}

void pressKey(uint8_t key) {
  if (!bleConnected || !inputKeyboard) return;
  
  uint8_t report[9];
  report[0] = 0x02;  // Report ID for Keyboard
  
  memcpy(&report[1], keyboardReport, 8);
  
  for (int i = 2; i < 8; i++) {
    if (report[i] == 0) {
      report[i] = key;
      break;
    }
  }
  
  memcpy(keyboardReport, &report[1], 8);
  
  inputKeyboard->setValue(report, 9);
  inputKeyboard->notify();
}

void releaseKey(uint8_t key) {
  if (!bleConnected || !inputKeyboard) return;
  
  uint8_t report[9];
  report[0] = 0x02;  
  memcpy(&report[1], keyboardReport, 8);
  
  for (int i = 2; i < 8; i++) {
    if (report[i] == key) {
      report[i] = 0;
      break;
    }
  }
  
  // Update state
  memcpy(keyboardReport, &report[1], 8);
  
  inputKeyboard->setValue(report, 9);
  inputKeyboard->notify();
}

void releaseAllKeys() {
  if (!bleConnected || !inputKeyboard) return;
  
  uint8_t report[9];
  report[0] = 0x02;  // Report ID for Keyboard
  memset(&report[1], 0, 8);
  memset(keyboardReport, 0, 8);
  
  inputKeyboard->setValue(report, 9);
  inputKeyboard->notify();
}

// ===== Battery Functions =====
float readBatteryVoltage() {
  float sum = 0;
  for (int i = 0; i < BATT_SAMPLES; i++) {
    int raw = analogRead(BATTERY_PIN);
    sum += (raw * ADC_REF / ADC_RES) * DIV_RATIO;
    delayMicroseconds(100);
  }
  float voltage = sum / BATT_SAMPLES;
  
  if (smoothedBatteryVoltage == 0) {
    smoothedBatteryVoltage = voltage;
  } else {
    smoothedBatteryVoltage = (smoothedBatteryVoltage * BATT_SMOOTH) + (voltage * (1.0 - BATT_SMOOTH));
  }
  
  return smoothedBatteryVoltage;
}

int getBatteryPercent() {
  float voltage = readBatteryVoltage();
  int percent = (int)((voltage - BATT_MIN) / (BATT_MAX - BATT_MIN) * 100.0);
  return constrain(percent, 0, 100);
}

void drawBatteryIcon(int x, int y, int percent) {
  display.drawRect(x, y, 12, 7, SSD1306_WHITE);
  display.fillRect(x + 12, y + 2, 2, 3, SSD1306_WHITE);
  
  int fillWidth = map(percent, 0, 100, 0, 10);
  
  if (fillWidth > 0) {
    display.fillRect(x + 1, y + 1, fillWidth, 5, SSD1306_WHITE);
  }
  
  if (percent < 20 && (millis() / 500) % 2 == 0) {
    display.drawRect(x, y, 12, 7, SSD1306_WHITE);
  }
}

// ===== Calibration =====
bool calibrateGyro() {
  const int samples = 200;
  float sumYaw = 0, sumPitch = 0, sumRoll = 0;
  
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(10, 20);
  display.println("Calibrating...");
  display.setCursor(10, 35);
  display.println("Keep still!");
  display.display();
  
  delay(500);
  
  for (int i = 0; i < samples; i++) {
    sensors_event_t a, g, t;
    if (!mpu.getEvent(&a, &g, &t)) {
      Serial.println("ERROR: Failed to read MPU during calibration!");
      return false;
    }
    sumYaw += g.gyro.z;
    sumPitch += g.gyro.y;
    sumRoll += g.gyro.x;
    delay(5);
  }
  
  gyroYawOffset = sumYaw / samples;
  gyroPitchOffset = sumPitch / samples;
  gyroRollOffset = sumRoll / samples;
  
  Serial.printf("✓ Gyro Calibrated - Yaw:%.3f Pitch:%.3f Roll:%.3f\n", 
                gyroYawOffset, gyroPitchOffset, gyroRollOffset);
  return true;
}

